# Get these connection details from your Uniform project.
UNIFORM_PROJECT_ID=
UNIFORM_API_KEY=

# This is used to set the preview secret for Uniform preview mode.
# adjust this to a random string for your project.
UNIFORM_PREVIEW_SECRET=hello-world

# defaults to localhost:3000 if not set.
#When set, should resolve to the base url of the app.
# This is used to generate the sitemap and robots.txt
BASE_URL=

# --- Uniform static API (Azure blob mirror) --------------------------------
# Base URL of the static API where the mirror Function writes route JSON.
# When set, RouteClient calls go through a fetch override that rewrites
# /api/v1/route to {base}/{projectId}/{base64url(path)}/64.json. The override
# is route-only — entries, project map, and canvas-by-id continue to hit
# https://uniform.global directly.
#
# Two common values:
#   • https://<account>.blob.core.windows.net/<container>     (direct blob, public read)
#   • https://<endpoint>.azurefd.net                          (Azure Front Door fronting the blob)
#
# Leave unset for dev / preview / SSR-without-mirror so those flows continue
# to hit the live Uniform edge directly.
UNIFORM_STATIC_API_BASE_URL=

# Browser-exposed equivalent. Required when the app uses CSR/SPA reads against
# the static API; Next.js inlines NEXT_PUBLIC_* into the client bundle.
NEXT_PUBLIC_UNIFORM_STATIC_API_BASE_URL=

# Pinned Next.js BUILD_ID used by generateBuildId. CI should pass the git SHA;
# locally the next.config.ts default ('pfg-uniform-build') is used if unset.
BUILD_DEPLOY_ID=