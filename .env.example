# Get these connection details from your Uniform project.
UNIFORM_PROJECT_ID=
UNIFORM_API_KEY=

# This is used to set the preview secret for Uniform preview mode.
# adjust this to a random string for your project.
UNIFORM_PREVIEW_SECRET=hello-world

# defaults to localhost:3000 if not set.
#When set, should resolve to the base url of the app.
# This is used to generate the sitemap and robots.txt
BASE_URL=

# --- Static-export build via Uniform edge mirror ---------------------------
# When set, RouteClient in the catch-all page reads composition JSON from this
# host instead of https://uniform.global. Intended for the static-export
# pipeline (RUNNING_MODE=build) to point at the mirror Azure Function URL,
# including the function key, e.g.:
#   https://<function-app>.azurewebsites.net/api/v1?code=<function-key>
# Leave unset for dev / preview / SSR so those flows continue to hit the
# live Uniform edge directly.
UNIFORM_API_HOST=

# Pinned Next.js BUILD_ID used by generateBuildId. CI should pass the git SHA;
# locally the next.config.ts default ('pfg-uniform-build') is used if unset.
BUILD_DEPLOY_ID=