    "MIRROR_RATE_LIMIT_RPS": "5",
    "MIRROR_LOCALE_DEFAULT": "en",
    "MIRROR_DYNAMIC_EXPANSIONS": "{\"location\":\"location\"}",
    "MIRROR_SEED_TIMER_CRON": "0 0 */6 * * *"
